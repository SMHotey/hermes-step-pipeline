{
  "project": "hermes-step-pipeline",
  "board": "step-pipeline",
  "ui_port": 8770,
  "max_fix_rounds": 3,
  "max_fix_rounds_high": 6,
  "max_actions": 2,
  "max_plan_growth": {
    "percent": 10,
    "chars_per_finding": 400,
    "enforce": false
  },
  "profiles": {
    "driver": "pipeline",
    "prompter": "prompter",
    "reviewer": "reviewer",
    "scout": "scout"
  },
  "routing": {
    "frontend": "pipeline",
    "backend": "pipeline",
    "devops": "pipeline",
    "designer": "pipeline",
    "security": "pipeline"
  },
  "skills": {
    "step": [
      "pipeline-next-step"
    ],
    "review": [
      "pipeline-reviewer"
    ],
    "prompt": [
      "pipeline-prompter",
      "agent-prompt-authoring"
    ],
    "scout": [
      "pipeline-scout"
    ]
  },
  "paths": {
    "plans": "docs/plans",
    "reviews": "docs/reviews",
    "prompts": "docs/prompts",
    "state": ".pipeline/state"
  },
  "markers": {
    "journal": "журнал",
    "steps": "шаг"
  },
  "plans": {
    "legacy": [
      "1",
      "2",
      "3",
      "4",
      "5",
      "6",
      "7",
      "8",
      "10",
      "12",
      "13",
      "15"
    ]
  },
  "step_id_regex": "(?P<id>[A-Za-z]{1,4}\\d+[A-Za-z]?(?:-\\d+)?)",
  "default_plan": null,
  "driven_plans": [
    "6",
    "8",
    "9",
    "10",
    "13",
    "14",
    "15"
  ],
  "require_prompt": true,
  "runtimes": {
    "step": "270m",
    "review": "225m",
    "prompt": "68m",
    "scout": "30m"
  },
  "kanban": {
    "tenant": "plan"
  },
  "git": {
    "commit": true,
    "push": true
  },
  "notify": {
    "enabled": true,
    "token_env": "STEP_PIPELINE_TELEGRAM_BOT_TOKEN",
    "chat_env": "STEP_PIPELINE_TELEGRAM_CHAT_ID",
    "prefix": ""
  },
  "quiet_hours": {
    "enabled": true,
    "windows": [
      {
        "from": "04:00",
        "to": "07:00"
      },
      {
        "from": "09:00",
        "to": "13:00"
      }
    ]
  }
}
