# Замер покрытия: ветки не считаем (см. отчёт шага — сознательно вне объёма).
# include, а не source: e2e-тесты запускают gate.py из временного проекта, и под
# source = step_pipeline эти копии в замер не попадали бы вовсе (цифра «22 %» — артефакт).
[run]
parallel = True
include =
    **/step_pipeline/*.py
    **/step_pipeline/engine/*.py
    **/.pipeline/*.py

[paths]
# Копия движка в проекте (`<временный проект>/.pipeline/gate.py`) — тот же файл, что
# step_pipeline/engine/gate.py; без этого правила combine оставляет её отдельной строкой.
engine =
    step_pipeline/engine/
    **/.pipeline/

[report]
show_missing = True
# Порог занижен от фактического на запас: на Windows замер 82 % (0.23.0), на Linux
# часть ветвей не исполняется (платформенные проверки), а падение на 4 пункта —
# уже регрессия тестов, а не разница платформ.
fail_under = 78
